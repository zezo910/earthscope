arnings": [], "p_combined": 0.004714, "bh_significant": true}}, "season_amplitude": 0.21481639999999996, "mean_value": 0.4689332}, "season_quiz": {"question": {"en": "Why did the wave disappear?", "ar": "لماذا اختفت الموجة؟"}, "answers": [{"id": "a", "text": {"en": "The data was deleted.", "ar": "تم حذف البيانات."}}, {"id": "b", "text": {"en": "We removed the normal yearly cycle, so only the change is left.", "ar": "أزلنا الدورة السنوية المعتادة فلم يتبق إلا التغير."}}, {"id": "c", "text": {"en": "The trend stopped.", "ar": "توقف الاتجاه."}}]}, "hypothesis_options": [{"id": "up", "en": "Increased", "ar": "زاد"}, {"id": "down", "en": "Decreased", "ar": "قل"}, {"id": "none", "en": "No real change", "ar": "لا تغير حقيقي"}], "verdict_options": [{"id": "real_trend", "en": "Real trend", "ar": "اتجاه حقيقي"}, {"id": "natural_variation", "en": "Natural variation", "ar": "تغير طبيعي"}, {"id": "need_more_data", "en": "Need more data", "ar": "نحتاج بيانات أكثر"}], "reasons": {"real_trend": [{"id": "r1", "en": "Both tests give p below 0.05 and the 95% interval excludes zero.", "ar": "الاختباران يعطيان p أقل من 0.05 وفاصل الثقة 95% لا يشمل الصفر."}, {"id": "r2", "en": "The line goes up on the chart, so it must be real.", "ar": "الخط يصعد في الرسم فلا بد أنه حقيقي."}, {"id": "r3", "en": "It feels like this has been changing lately.", "ar": "يبدو أن هذا يتغير في الفترة الأخيرة."}], "natural_variation": [{"id": "n1", "en": "The p-values are well above 0.05, so the slope could be chance.", "ar": "قيم p أعلى بكثير من 0.05 فالميل قد يكون صدفة."}, {"id": "n2", "en": "The line is flat, so nothing is happening.", "ar": "الخط مسطح إذن لا شيء يحدث."}, {"id": "n3", "en": "The data has gaps, so it can't be trusted.", "ar": "البيانات فيها فجوات فلا يمكن الوثوق بها."}], "need_more_data": [{"id": "m1", "en": "The evidence is borderline or the record is shorter than the years needed to detect it.", "ar": "الدليل حدي أو السجل أقصر من السنين اللازمة لكشف التغير."}, {"id": "m2", "en": "A result that passes one test but not the other should not be trusted yet.", "ar": "نتيجة تنجح في اختبار وتفشل في آخر لا يوثق بها بعد."}, {"id": "m3", "en": "I just don't like the chart.", "ar": "لا يعجبني الرسم فقط."}]}, "twist": {"kind": "same_direction_different_speed", "ratio_b_over_a": 0.4129712720703922, "headline": {"en": "Same variable. Different speeds.", "ar": "نفس المتغير. سرعات مختلفة."}, "body": {"en": "Both changed the same way, but at clearly different rates.", "ar": "كلاهما تغير في نفس الاتجاه لكن بمعدلين مختلفين بوضوح."}}}